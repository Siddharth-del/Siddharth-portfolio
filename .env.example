# URL of the Spring Boot backend that serves /api/ask-question (AI assistant) and /api/contact.
# Leave empty to use the built-in offline assistant and a mailto contact form.
VITE_API_BASE_URL=

# Set to true if the backend is served from the same domain as this site (e.g. /api/* proxied).
VITE_USE_SAME_ORIGIN_API=false
