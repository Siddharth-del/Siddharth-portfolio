# Copy this file to .env and fill in your key to enable the live AI assistant.
# Get a key from https://console.anthropic.com
#
# SECURITY NOTE: This calls the Anthropic API directly from the browser, which
# exposes your API key to anyone who opens devtools. That's fine for local
# development or a private demo, but before deploying this publicly you should
# move the API call behind a small backend/serverless proxy (e.g. a single
# Vercel/Netlify function) that holds the key server-side instead.
VITE_ANTHROPIC_API_KEY=
